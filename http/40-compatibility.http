### Legacy telemetry ingestion route
POST {{baseUrl}}/telemetry/data
Content-Type: application/json

{
  "mod_id": "{{testModId}}",
  "mod_version": "1.0.0",
  "game_version": "1.21.1",
  "loader": "fabric"
}

> {%
client.test("legacy telemetry route records data", () => {
  client.assert(response.status === 201, "Expected 201 but received " + response.status);
});
%}

